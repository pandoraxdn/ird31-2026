QWidget{
  background: #FFFFFF;
}

#titulo{
  font-size: 34px;
  color:black;
}

#boton{
  background:qlineargradient(
    x1:0,y1:0,x2:1,y2:1,
    stop:0 #4facfe,
    stop:1 #00f2fe
  );
  color: white;
  font-size: 20px;
  font-weight: bold;
  border: none;
  border-radius: 12px;
  padding: 12px;
}

#boton:hover{
  background:qlineargradient(
    x1:0,y1:0,x2:1,y2:1,
    stop:0 #27F55E,
    stop:1 #27E7F5
  );
}

#boton:pressed{
  background:qlineargradient(
    x1:0,y1:0,x2:1,y2:1,
    stop:0 #CC27F5,
    stop:1 #DE31CC
  );
}

QLineEdit{
  background:#334155;
  border:2px solid #475569;
  border-radius:12px;
  padding:14px;
  font-size:20px;
  color:white;
}



